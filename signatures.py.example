"""예선 dahAgent 공격 패킷 기반 시그니처 예시

예선 코드에서 확인된 MAVLink PARAM_SET 및 CCSDS TC 페이로드의 관찰 가능 문자열
대상 예시이며 본선 프로토콜과 포트 확인 전 즉시 차단용 룰이 아닌 초기 탐지 후보

MAVLink 메시지 ID, 서명, 재전송, 시퀀스 및 CCSDS 패킷 구조 검사는
defender.py의 프로토콜 검사기 담당
MAVLink 수치 필드와 ROS 2/DDS CDR 필드 검사는 정규식 룰이 아닌 전용 파서 필요
"""

SIGNATURES = [
    # 지원 필드: pattern(필수), id, port, reason, weight, target
    # 예선 MAVLink 기본 포트 14550 기준이며 리허설에서 실제 포트 확인 후 변경
    # PARAM_SET 프레임에 포함되는 고정 길이 param_id 문자열 기반 보조 신호
    # 파라미터 이름만으로 비정상 수치까지 입증할 수 없어 단독 DROP 미만 점수
    {"id": "PRELIM-MAV-PARAM-EKF-ACC", "port": 14550,
     "pattern": r"EK3_ACC_P_NSE", "reason": "예선 MAVLink EKF 가속도 잡음 파라미터 변경",
     "weight": 0.5, "target": "raw"},
    {"id": "PRELIM-MAV-PARAM-EKF-GYRO", "port": 14550,
     "pattern": r"EK3_GYRO_P_NSE", "reason": "예선 MAVLink EKF 자이로 잡음 파라미터 변경",
     "weight": 0.5, "target": "raw"},
    {"id": "PRELIM-MAV-PARAM-PITCH", "port": 14550,
     "pattern": r"(?:ATC_RAT_PIT_P|RATE_PIT_P)",
     "reason": "예선 MAVLink 피치 제어 이득 파라미터 변경",
     "weight": 0.5, "target": "raw"},
    {"id": "PRELIM-MAV-PARAM-ROLL", "port": 14550,
     "pattern": r"(?:ATC_RAT_RLL_P|RATE_RLL_P)",
     "reason": "예선 MAVLink 롤 제어 이득 파라미터 변경",
     "weight": 0.5, "target": "raw"},

    # 예선 CCSDS 기본 UDP 포트 5111과 APID 0x123 환경의 ASCII TC 명령 기반 신호
    # DISABLE 명령 문자열만으로 인증 부재를 입증할 수 없어 단독 DROP 미만 점수
    {"id": "PRELIM-CCSDS-TC-DISABLE", "port": 5111,
     "pattern": r"DISABLE", "reason": "예선 CCSDS 단말 비활성화 TC 명령",
     "weight": 0.5, "target": "raw"},
]

# 예선 공격 패킷과 충돌하지 않는 정상 패턴을 확정할 자료 부재에 따른 빈 허용 목록
WHITELIST = []

# 프로토콜 구조 검사용 권장 초기 환경변수
# 본선 프로토콜 미공개 상태의 오탐 방지를 위한 observe 모드
# DEF_MAVLINK_MODE=observe
# DEF_MAVLINK_PORTS=14550
# DEF_MAVLINK_REQUIRE_SIGNED=1
# DEF_CCSDS_MODE=observe
# DEF_CCSDS_PORTS=5111
# DEF_RTPS_MODE=observe
# DEF_RTPS_PORTS=<리허설에서 확인한 포트>

# PARAM_RANGES는 HTTP query/form 형식용 설정
# MAVLink PARAM_SET의 float 값 검사는 전용 MAVLink 필드 파서로 구현할 대상
# ROS 2 /cmd_vel 및 /scan은 RTPS DATA와 CDR 타입 해석이 필요해 문자열 룰에서 제외
